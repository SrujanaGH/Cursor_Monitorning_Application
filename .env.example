# Copy to .env and fill in local values. Do not commit .env.
# Demo only — never use these values outside a trusted lab network.

# Required in non-demo mode. For local demo, omit to get an ephemeral key (console warning).
SECRET_KEY=change-me-to-a-long-random-string

# Demo admin seed (hashed at rest on first run). Username defaults to admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: set to 1 to enable Flask debug (off by default).
FLASK_DEBUG=0

# Optional: set to 0 to require SECRET_KEY (fail startup if missing). Default 1 = local demo mode.
DEMO_MODE=1

# Optional SQLite URL override (default: sqlite:///instance/monitorlab.db)
# DATABASE_URL=sqlite:///instance/monitorlab.db

# Metrics auto-refresh interval in seconds (5–10 recommended)
METRICS_REFRESH_SECONDS=7
