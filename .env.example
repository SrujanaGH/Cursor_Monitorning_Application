# Copy to .env and fill in local values. Do not commit .env.
# Demo only — never use these placeholders in a real deployment.

# Required in non-demo mode. For local demo, omit to get an ephemeral key (with a console warning).
SECRET_KEY=change-me-to-a-long-random-string

# Demo admin seed password (hashed at rest in later phases). Local lab only.
# Default username: admin
ADMIN_PASSWORD=admin123

# Optional: set to 1 to enable Flask debug (off by default).
FLASK_DEBUG=0

# Optional: set to 0 to require SECRET_KEY (fail startup if missing). Default 1 = local demo mode.
DEMO_MODE=1
